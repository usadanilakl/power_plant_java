global.env
# Kiosk device profile (baked into the jar, selected by DEVICE_CONFIG=kiosk) — holds the hub kiosk credential
/src/main/resources/device-configs/kiosk.properties
/electron-manager/config-defaults/
/data/certificate.pfx
# SharePoint cert PEM — contains a PRIVATE KEY; provision out-of-band, never commit.
/data/certificate.pem
# Hub JWT signing keys (RS256) — NEVER commit the private key; public key is distributed separately.
/data/jwt-private.pem
/data/jwt-public.pem
/data/supabase-jwt-public.pem
/data/backups/
/exports/**
/electron-manager/release2/**

# Backend port file for Angular dev server
backend-port.txt
/electron-manager/vosk-model/**
/.m2repo/**
# Maximo inventory catalog snapshot — a rebuildable cache, not data
/data/cache/

# Local DB backups / snapshots (never commit — GitHub 100MB limit)
db/*.bak
db/*.mv.db
db/*.trace.db
db/*.old
