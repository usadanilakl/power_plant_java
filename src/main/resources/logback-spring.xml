<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOGS" value="./logs" />
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%thread] %logger{32} - %msg%n%throwable" />
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [req=%X{requestId:-} user=%X{userId:-} machine=%X{machineId:-} job=%X{jobName:-} jobRun=%X{jobRunId:-} sync=%X{syncRunId:-} entity=%X{entityType:-}/%X{entityId:-} sp=%X{sharepointId:-}] %logger{40} - %msg%n%throwable" />

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${CONSOLE_LOG_PATTERN}</Pattern>
        </encoder>
    </appender>

    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/power-plant-logger.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${LOG_PATTERN}</Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/power-plant-logger-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="SyncFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/power-plant-sync.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${LOG_PATTERN}</Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/power-plant-sync-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="SecurityFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/power-plant-security.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${LOG_PATTERN}</Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/power-plant-security-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>2MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>20MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="WarnErrorFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/power-plant-alerts.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>${LOG_PATTERN}</Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/power-plant-alerts-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>50MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <root level="info">
        <appender-ref ref="RollingFile" />
        <appender-ref ref="WarnErrorFile" />
        <appender-ref ref="Console" />
    </root>

    <logger name="com.dk_power.power_plant_java" level="info" />

    <logger name="com.dk_power.power_plant_java.config.logging.RequestCorrelationFilter" level="warn" />

    <logger name="com.dk_power.power_plant_java.config.security" level="info" additivity="false">
        <appender-ref ref="SecurityFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.controller.auth" level="info" additivity="false">
        <appender-ref ref="SecurityFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.sevice.sharepoint" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.sevice.hub" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <!-- Migration service logs to main file + console for visibility -->
    <logger name="com.dk_power.power_plant_java.sevice.hub.H2ToPostgresMigrationService" level="info" additivity="false">
        <appender-ref ref="RollingFile" />
        <appender-ref ref="WarnErrorFile" />
        <appender-ref ref="Console" />
    </logger>

    <logger name="com.dk_power.power_plant_java.controller.hub" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.sevice.sync.SyncHealthChecker" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.sevice.sync.PeerDiscoveryService" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.sevice.sync" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.controller.sync" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>

    <logger name="com.dk_power.power_plant_java.controller.sync_and_backup" level="info" additivity="false">
        <appender-ref ref="SyncFile" />
        <appender-ref ref="WarnErrorFile" />
    </logger>
</configuration>
