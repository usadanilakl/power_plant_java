{
  "name": "electron-manager",
  "version": "1.0.0",
  "description": "Desktop Manager for Power Plant Java apps",
  "main": "dist/main/main/main.js",
  "author": "DK Power",
  "license": "MIT",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "cd src/renderer && npm run build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build:main && electron .",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "cd src/renderer && npm start",
    "electron": "electron .",
    "download-jre": "node scripts/download-jre.js",
    "prepackage": "npm run download-jre",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "package:zip": "npm run package:dir && node scripts/create-update-zip.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.dkpower.electron-manager",
    "productName": "DK Power Manager",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "jre",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../tessdata",
        "to": "tessdata",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "config-defaults",
        "to": "config-defaults",
        "filter": [
          "*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
