{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)",
          "!/data/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "app-data",
      "urls": [
        "/permits/data/work-areas.json",
        "/permits/data/work-area-shapes.json",
        "/permits/data/work-categories.json",
        "/permits/data/default-instruments.json",
        "/permits/data/locations.json",
        "/permits/data/loto-points.json",
        "/permits/data/field-list-types.json"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "1h",
        "strategy": "freshness",
        "timeout": "5s"
      }
    }
  ]
}
